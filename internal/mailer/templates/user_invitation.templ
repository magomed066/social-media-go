{{define "subject"}}Finish Registration with Go Social{{end}}

{{define "body"}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Activate your Go Social account</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f3f4f6; font-family: Arial, Helvetica, sans-serif; color: #111827;">
  <table role="presentation" style="width: 100%; border-collapse: collapse; background-color: #f3f4f6;">
    <tr>
      <td align="center" style="padding: 32px 16px;">
        <table role="presentation" style="width: 100%; max-width: 560px; border-collapse: collapse; background-color: #ffffff;">
          <tr>
            <td style="padding: 32px;">
              <p style="margin: 0 0 24px; font-size: 18px; font-weight: bold; color: #2563eb;">Go Social</p>
              <h1 style="margin: 0 0 24px; font-size: 26px; line-height: 1.3;">Welcome to Go Social!</h1>
              <p style="margin: 0 0 16px; line-height: 1.6;">Hi {{.Username}},</p>
              <p style="margin: 0 0 24px; line-height: 1.6;">You're almost ready to join the conversation. Confirm your email address to activate your account.</p>
              <table role="presentation" style="border-collapse: collapse; margin-bottom: 24px;">
                <tr>
                  <td style="background-color: #2563eb; border-radius: 6px; text-align: center;">
                    <a href="{{.ActivationURL}}" style="display: inline-block; padding: 14px 24px; color: #ffffff; font-weight: bold; text-decoration: none;">Activate your account</a>
                  </td>
                </tr>
              </table>
              <p style="margin: 0 0 16px; line-height: 1.6;">This invitation expires in 72 hours. If the button doesn't work, copy and paste this link into your browser:</p>
              <p style="margin: 0 0 24px; line-height: 1.6; overflow-wrap: anywhere; word-break: break-all;"><a href="{{.ActivationURL}}" style="color: #2563eb;">{{.ActivationURL}}</a></p>
              <p style="margin: 0; font-size: 14px; line-height: 1.6; color: #6b7280;">If you didn't create a Go Social account, you can ignore this email.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
{{end}}
